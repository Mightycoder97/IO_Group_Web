# IO Group - Environment Configuration
# ⚠️ Copy as .env and fill in your values
# This file should NEVER contain real credentials

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_secure_password
DB_CHARSET=utf8mb4

# JWT Configuration (generate a strong random secret)
JWT_SECRET=generate_a_64_char_random_string_here
JWT_EXPIRE=86400

# CORS (your frontend domain)
CORS_ORIGIN=https://yourdomain.com

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# SUNAT API Token
SUNAT_API_TOKEN=your_sunat_api_token

# Vertex AI / Gemini Document Processing
# Option A: Vertex AI API key
GOOGLE_API_KEY=your_vertex_ai_api_key
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_LOCATION=global
GEMINI_VERTEX_MODEL=gemini-2.5-flash

# Option B: Vertex AI service account JSON
VERTEX_PROJECT_ID=your-google-cloud-project
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash
VERTEX_SERVICE_ACCOUNT_JSON_BASE64=base64_encoded_service_account_json

# Upload Configuration
UPLOAD_PATH=./uploads

# SMTP Configuration (for sending emails)
SMTP_HOST=mail.iogroup.pe
SMTP_PORT=465
SMTP_USER=noreply@iogroup.pe
SMTP_PASSWORD=your_smtp_password
SMTP_SECURE=ssl
