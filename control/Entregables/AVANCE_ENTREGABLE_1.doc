<html>
<head>
  <meta charset="utf-8">
  <title>Avance Del Proyecto - Entregable 1</title>
  <style>
    body { font-family: Arial, sans-serif; font-size: 11pt; color: #1f2933; line-height: 1.45; }
    h1 { font-size: 20pt; color: #12355b; margin-bottom: 8px; }
    h2 { font-size: 14pt; color: #1c4f7a; margin-top: 24px; border-bottom: 1px solid #cfd8e3; padding-bottom: 4px; }
    h3 { font-size: 12pt; color: #1f2933; margin-top: 18px; }
    table { border-collapse: collapse; width: 100%; margin: 12px 0 18px; }
    th, td { border: 1px solid #cbd5e1; padding: 7px; vertical-align: top; }
    th { background: #e8f1f8; color: #12355b; text-align: left; }
    .meta { color: #52606d; margin-bottom: 18px; }
    .status { font-weight: bold; color: #166534; }
    .screenshot-box {
      border: 2px dashed #94a3b8;
      height: 220px;
      margin: 12px 0;
      display: table;
      width: 100%;
      background: #f8fafc;
    }
    .screenshot-box div {
      display: table-cell;
      text-align: center;
      vertical-align: middle;
      color: #64748b;
      font-weight: bold;
    }
    .notes {
      border: 1px solid #cbd5e1;
      height: 80px;
      margin: 8px 0 18px;
      padding: 8px;
    }
    code { background: #f1f5f9; padding: 2px 4px; }
  </style>
</head>
<body>
  <h1>Avance Del Proyecto - Entregable 1</h1>
  <p class="meta">
    Fecha: 2026-05-05<br>
    Proyecto: IO Group Web - Control<br>
    Entregable: Etapa 1 - Base Tecnica y Despliegue<br>
    Estado: <span class="status">Completado</span>
